# NAGPUR-R2 — Environment Variables
# Copy this file to .env and fill in values as needed.

# ── Backend host/port ─────────────────────────────────────────────────────
# Not read by the app itself — set via uvicorn CLI args:
#   uvicorn main:app --host 0.0.0.0 --port 8000

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all (hackathon default).
# Example: CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# ── M1 → Backend ─────────────────────────────────────────────────────────
# M1 runner should have this set so it posts risk updates here.
# M1_TARGET_URL=http://localhost:8000

# ── M2 graph data paths (optional override) ──────────────────────────────
# Defaults to modules/m2_risk_propagation/data/{locations,roads}.json
# M2_LOCATIONS_FILE=
# M2_ROADS_FILE=
